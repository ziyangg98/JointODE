# ============================================================================
# Joint ODE Model Visualization Test
# ============================================================================
# This script generates diagnostic and presentation plots for a fitted
# JointODE model, including:
#   - Residual plots for model diagnostics
#   - Individual trajectory predictions
#   - Population-level average trends by covariate groups
#   - Random effects distribution
# ============================================================================

devtools::load_all()

cat("\n========================================\n")
cat("JointODE Visualization Test\n")
cat("========================================\n")

# Load fitted model
cat("\n[Step 1/2] Loading fitted model...\n")
fit <- readRDS(
  "/Users/gongziyang/Desktop/JointODE-SIM/fits/jointode_n=200_m=30_seed=400.rds"
)
cat(sprintf("  ✓ Model loaded: %d subjects\n", fit$nobs))

# Get predictions
cat("\n[Step 2/2] Computing predictions...\n")
pred <- predict(fit)
cat("  ✓ Predictions computed\n")

cat("\n========================================\n")
cat("Generating Visualization Plots\n")
cat("========================================\n")

# ============================================================================
# Residual Diagnostic Plot
# ============================================================================
cat("\n[Plot 1/5] Residual diagnostic plot...\n")

# Extract observed data from fit$data (the data actually used in fitting)
observed_data <- do.call(rbind, lapply(seq_along(fit$data), function(i) {
  subj <- fit$data[[i]]
  data.frame(
    id = names(fit$data)[i],
    time = subj$longitudinal$times,
    observed = subj$longitudinal$measurements,
    stringsAsFactors = FALSE
  )
}))

# Merge predictions with observed data
merged <- merge(
  observed_data,
  pred[, c("id", "time", "biomarker")],
  by = c("id", "time"),
  all.x = TRUE
)

# Calculate residuals
merged$residual <- merged$observed - merged$biomarker

# Remove NA residuals (if any)
merged <- merged[!is.na(merged$residual), ]

# Create residual plot
library(ggplot2)

p_residuals <- ggplot(merged, aes(x = time, y = residual)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "gray40", linewidth = 0.5) +
  geom_point(alpha = 0.25, size = 0.9, color = "gray20") +
  labs(x = "Time", y = "Residual") +
  theme_bw(base_size = 11) +
  theme(
    panel.grid.minor = element_blank(),
    panel.border = element_rect(color = "gray70", linewidth = 0.5),
    axis.title = element_text(size = 10)
  )

ggsave(
  filename = "residuals.png",
  plot = p_residuals,
  width = 8,
  height = 5,
  dpi = 300
)

cat("  ✓ Saved: residuals.png\n")

# ============================================================================
# Individual Trajectory Predictions
# ============================================================================
cat("\n[Plot 2/5] Individual trajectory predictions...\n")

# Randomly select subjects for visualization
set.seed(123)
n_subjects <- 6
all_ids <- names(fit$data)
subjects_to_plot <- sample(all_ids, min(n_subjects, length(all_ids)))
n_subjects_to_plot <- length(subjects_to_plot)

# Prepare data for trajectory plot
pred_subset <- pred[pred$id %in% subjects_to_plot, ]
obs_subset <- observed_data[observed_data$id %in% subjects_to_plot, ]

# Determine event status for each subject
event_status <- do.call(rbind, lapply(subjects_to_plot, function(sid) {
  subj_idx <- which(names(fit$data) == as.character(sid))
  if (length(subj_idx) > 0) {
    data.frame(
      id = sid,
      event_time = fit$data[[subj_idx]]$time,
      status = fit$data[[subj_idx]]$status,
      stringsAsFactors = FALSE
    )
  } else {
    NULL
  }
}))

# Merge event status with prediction data
pred_with_status <- merge(pred_subset, event_status, by = "id")
obs_with_status <- merge(obs_subset, event_status, by = "id")

# Add facet labels: Simple "ID X" format
pred_with_status$facet_label <- sprintf("ID %s", pred_with_status$id)
obs_with_status$facet_label <- sprintf("ID %s", obs_with_status$id)

# Sort subjects by event time (survival time)
event_status <- event_status[order(event_status$event_time), ]

# Create facet labels: Simple "ID X" format
event_status$facet_label <- sprintf("ID %s", event_status$id)
label_order <- event_status$facet_label

# Apply ordering to all data frames
pred_with_status$facet_label <- factor(pred_with_status$facet_label, levels = label_order)
obs_with_status$facet_label <- factor(obs_with_status$facet_label, levels = label_order)
event_status$facet_label <- factor(event_status$facet_label, levels = label_order)

# ============================================================================
# Combined Individual Predictions Plot
# ============================================================================

library(tidyr)
library(patchwork)

# Define variable levels (used consistently across all data frames)
var_levels <- c("Survival", "Biomarker", "Velocity", "Acceleration")

# Helper function to create ordered factor for variable column
make_var_factor <- function(x, levels = var_levels) {
  factor(x, levels = levels, ordered = TRUE)
}

# Prepare combined data with all variables
pred_all <- pred_subset[, c("id", "time", "survival", "biomarker", "velocity", "acceleration")]
pred_all <- tidyr::pivot_longer(
  pred_all,
  cols = c(survival, biomarker, velocity, acceleration),
  names_to = "variable",
  values_to = "value"
)

# Set variable factor and merge with event status
pred_all$variable <- factor(
  pred_all$variable,
  levels = c("survival", "biomarker", "velocity", "acceleration"),
  labels = var_levels,
  ordered = TRUE
)
pred_all <- merge(pred_all, event_status, by = "id")
pred_all$facet_label <- factor(pred_all$facet_label, levels = label_order)
pred_all$variable <- make_var_factor(pred_all$variable)

# Prepare observed data for biomarker
obs_for_plot <- obs_with_status[, c("id", "time", "observed", "status", "facet_label")]
obs_for_plot$variable <- make_var_factor("Biomarker")
obs_for_plot$facet_label <- factor(obs_for_plot$facet_label, levels = label_order)

# Prepare auxiliary data frames for reference lines
vline_data <- merge(event_status, data.frame(variable = var_levels))
vline_data$variable <- make_var_factor(vline_data$variable)

hline_data <- data.frame(
  variable = c("Velocity", "Acceleration"),
  yintercept = 0
)
hline_data$variable <- make_var_factor(hline_data$variable)

# Create the combined plot (clean black and white style)
p_combined <- ggplot(pred_all, aes(x = time, y = value)) +
  geom_line(color = "black", linewidth = 0.6, alpha = 0.8) +
  geom_point(
    data = obs_for_plot,
    aes(x = time, y = observed),
    color = "black",
    size = 1.2,
    alpha = 0.4,
    shape = 16
  ) +
  geom_vline(
    data = vline_data,
    aes(xintercept = event_time, linetype = factor(status)),
    color = "gray40",
    linewidth = 0.4,
    alpha = 0.6
  ) +
  geom_hline(
    data = hline_data,
    aes(yintercept = yintercept),
    linetype = "dashed",
    color = "gray60",
    linewidth = 0.3
  ) +
  facet_grid(
    variable ~ facet_label,
    scales = "free_y",
    switch = "y"
  ) +
  scale_linetype_manual(
    values = c("0" = "dashed", "1" = "solid"),
    labels = c("0" = "Censored", "1" = "Event"),
    name = "Event Status"
  ) +
  labs(
    x = "Time",
    y = NULL
  ) +
  theme_bw(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 14, hjust = 0),
    plot.margin = margin(12, 12, 8, 12),
    strip.text.x = element_text(face = "bold", size = 8),
    strip.text.y.left = element_text(face = "bold", size = 9, angle = 0, hjust = 1),
    strip.background = element_rect(fill = "gray95", color = "gray80"),
    strip.placement = "outside",
    legend.position = "bottom",
    legend.title = element_text(face = "bold", size = 9),
    legend.text = element_text(size = 8.5),
    legend.key.width = unit(1.5, "cm"),
    panel.spacing.x = unit(0.5, "lines"),
    panel.spacing.y = unit(0.5, "lines"),
    panel.border = element_rect(color = "gray70", fill = NA, linewidth = 0.4),
    panel.grid.major = element_line(color = "gray90", linewidth = 0.3),
    panel.grid.minor = element_blank(),
    axis.text = element_text(size = 8),
    axis.title.x = element_text(size = 10, face = "bold", margin = margin(t = 8))
  )

ggsave(
  filename = "trajectories-individual.png",
  plot = p_combined,
  width = 15,
  height = 10,
  dpi = 300
)

cat("  ✓ Saved: trajectories-individual.png\n")

# ============================================================================
# Population-Level Average Trends (by w2)
# ============================================================================
cat("\n[Plot 3/5] Population-level trends by w2 groups...\n")

# Extract w2 values from covariates in fit$data
w2_values <- do.call(rbind, lapply(names(fit$data), function(sid) {
  subj_idx <- which(names(fit$data) == as.character(sid))
  if (length(subj_idx) > 0) {
    # Get w2 from covariates
    w2 <- fit$data[[subj_idx]]$covariates[1, "w2"]
    data.frame(
      id = sid,
      w2 = w2,
      stringsAsFactors = FALSE
    )
  } else {
    NULL
  }
}))

# Merge predictions with w2 values
pred_with_w2 <- merge(pred, w2_values[, c("id", "w2")], by = "id")

# Convert w2 to factor for grouping (since w2 is discrete)
pred_with_w2$w2_group <- factor(pred_with_w2$w2, labels = paste("w2 =", sort(unique(pred_with_w2$w2))))

# Calculate average trends by w2 group and time
library(dplyr)
avg_trends <- pred_with_w2 %>%
  group_by(w2_group, time) %>%
  summarise(
    biomarker_mean = mean(biomarker, na.rm = TRUE),
    biomarker_se = sd(biomarker, na.rm = TRUE) / sqrt(n()),
    velocity_mean = mean(velocity, na.rm = TRUE),
    velocity_se = sd(velocity, na.rm = TRUE) / sqrt(n()),
    acceleration_mean = mean(acceleration, na.rm = TRUE),
    acceleration_se = sd(acceleration, na.rm = TRUE) / sqrt(n()),
    survival_mean = mean(survival, na.rm = TRUE),
    survival_se = sd(survival, na.rm = TRUE) / sqrt(n()),
    .groups = "drop"
  )

# Define colors for w2 groups
n_groups <- length(unique(pred_with_w2$w2_group))
group_colors <- if (n_groups == 2) {
  c("#3498db", "#e74c3c")  # Blue and Red for binary
} else {
  scales::hue_pal()(n_groups)  # Default ggplot colors for multiple groups
}

# Panel A: Average Biomarker trajectories by w2 group (smoothed)
p_avg_biomarker <- ggplot(pred_with_w2, aes(x = time, y = biomarker, color = w2_group, fill = w2_group)) +
  geom_smooth(method = "loess", se = TRUE, alpha = 0.2, linewidth = 1.2) +
  scale_color_manual(values = group_colors, name = "Group") +
  scale_fill_manual(values = group_colors, name = "Group") +
  theme_bw(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 12),
    panel.grid.minor = element_blank(),
    panel.border = element_rect(color = "gray70", linewidth = 0.5),
    legend.position = "right"
  ) +
  labs(
    title = "Biomarker",
    x = "Time",
    y = "Biomarker"
  )

# Panel B: Average Velocity by w2 group (smoothed)
p_avg_velocity <- ggplot(pred_with_w2, aes(x = time, y = velocity, color = w2_group, fill = w2_group)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "gray40", linewidth = 0.5) +
  geom_smooth(method = "loess", se = TRUE, alpha = 0.2, linewidth = 1.2) +
  scale_color_manual(values = group_colors, name = "Group") +
  scale_fill_manual(values = group_colors, name = "Group") +
  theme_bw(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 12),
    panel.grid.minor = element_blank(),
    panel.border = element_rect(color = "gray70", linewidth = 0.5),
    legend.position = "right"
  ) +
  labs(
    title = "Velocity",
    x = "Time",
    y = "Velocity"
  )

# Panel C: Average Acceleration by w2 group (smoothed)
p_avg_acceleration <- ggplot(pred_with_w2, aes(x = time, y = acceleration, color = w2_group, fill = w2_group)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "gray40", linewidth = 0.5) +
  geom_smooth(method = "loess", se = TRUE, alpha = 0.2, linewidth = 1.2) +
  scale_color_manual(values = group_colors, name = "Group") +
  scale_fill_manual(values = group_colors, name = "Group") +
  theme_bw(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 12),
    panel.grid.minor = element_blank(),
    panel.border = element_rect(color = "gray70", linewidth = 0.5),
    legend.position = "right"
  ) +
  labs(
    title = "Acceleration",
    x = "Time",
    y = "Acceleration"
  )

# Panel D: Average Survival by w2 group (smoothed)
p_avg_survival <- ggplot(pred_with_w2, aes(x = time, y = survival, color = w2_group, fill = w2_group)) +
  geom_smooth(method = "loess", se = TRUE, alpha = 0.2, linewidth = 1.2) +
  scale_color_manual(values = group_colors, name = "Group") +
  scale_fill_manual(values = group_colors, name = "Group") +
  scale_y_continuous(limits = c(0, 1), breaks = seq(0, 1, 0.2)) +
  theme_bw(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 12),
    panel.grid.minor = element_blank(),
    panel.border = element_rect(color = "gray70", linewidth = 0.5),
    legend.position = "right"
  ) +
  labs(
    title = "Survival",
    x = "Time",
    y = "Survival Probability"
  )

# Combine all panels using patchwork (Survival, Biomarker, Velocity, Acceleration)
library(patchwork)
p_avg_combined <- (p_avg_survival | p_avg_biomarker) / (p_avg_velocity | p_avg_acceleration)

ggsave(
  filename = "trajectories-population-w2.png",
  plot = p_avg_combined,
  width = 14,
  height = 10,
  dpi = 300
)

cat("  ✓ Saved: trajectories-population-w2.png\n")

# ============================================================================
# Population-Level Average Trends (by x1)
# ============================================================================
cat("\n[Plot 4/5] Population-level trends by x1 groups...\n")

# Extract x1 values from longitudinal covariates in fit$data
x1_values <- do.call(rbind, lapply(names(fit$data), function(sid) {
  subj_idx <- which(names(fit$data) == as.character(sid))
  if (length(subj_idx) > 0) {
    # Get x1 from longitudinal$covariates (take first value)
    covs <- fit$data[[subj_idx]]$longitudinal$covariates$fixed
    if (!is.null(covs) && "x1" %in% colnames(covs)) {
      x1 <- covs[1, "x1"]
      data.frame(
        id = sid,
        x1 = x1,
        stringsAsFactors = FALSE
      )
    } else {
      NULL
    }
  } else {
    NULL
  }
}))

# Merge predictions with x1 values
pred_with_x1 <- merge(pred, x1_values[, c("id", "x1")], by = "id")

# Create x1 groups using tertiles (Low, Medium, High)
x1_tertiles <- quantile(pred_with_x1$x1, probs = c(0, 1/3, 2/3, 1))
pred_with_x1$x1_group <- cut(
  pred_with_x1$x1,
  breaks = x1_tertiles,
  labels = c("Low x1", "Medium x1", "High x1"),
  include.lowest = TRUE
)

# Define colors for x1 groups
group_colors_x1 <- c("#2ecc71", "#f39c12", "#e74c3c")  # Green, Orange, Red

# Panel A: Average Biomarker trajectories by x1 group (smoothed)
p_x1_biomarker <- ggplot(pred_with_x1, aes(x = time, y = biomarker, color = x1_group, fill = x1_group)) +
  geom_smooth(method = "loess", se = TRUE, alpha = 0.2, linewidth = 1.2) +
  scale_color_manual(values = group_colors_x1, name = "Group") +
  scale_fill_manual(values = group_colors_x1, name = "Group") +
  theme_bw(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 12),
    panel.grid.minor = element_blank(),
    panel.border = element_rect(color = "gray70", linewidth = 0.5),
    legend.position = "right"
  ) +
  labs(
    title = "Biomarker",
    x = "Time",
    y = "Biomarker"
  )

# Panel B: Average Velocity by x1 group (smoothed)
p_x1_velocity <- ggplot(pred_with_x1, aes(x = time, y = velocity, color = x1_group, fill = x1_group)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "gray40", linewidth = 0.5) +
  geom_smooth(method = "loess", se = TRUE, alpha = 0.2, linewidth = 1.2) +
  scale_color_manual(values = group_colors_x1, name = "Group") +
  scale_fill_manual(values = group_colors_x1, name = "Group") +
  theme_bw(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 12),
    panel.grid.minor = element_blank(),
    panel.border = element_rect(color = "gray70", linewidth = 0.5),
    legend.position = "right"
  ) +
  labs(
    title = "Velocity",
    x = "Time",
    y = "Velocity"
  )

# Panel C: Average Acceleration by x1 group (smoothed)
p_x1_acceleration <- ggplot(pred_with_x1, aes(x = time, y = acceleration, color = x1_group, fill = x1_group)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "gray40", linewidth = 0.5) +
  geom_smooth(method = "loess", se = TRUE, alpha = 0.2, linewidth = 1.2) +
  scale_color_manual(values = group_colors_x1, name = "Group") +
  scale_fill_manual(values = group_colors_x1, name = "Group") +
  theme_bw(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 12),
    panel.grid.minor = element_blank(),
    panel.border = element_rect(color = "gray70", linewidth = 0.5),
    legend.position = "right"
  ) +
  labs(
    title = "Acceleration",
    x = "Time",
    y = "Acceleration"
  )

# Panel D: Average Survival by x1 group (smoothed)
p_x1_survival <- ggplot(pred_with_x1, aes(x = time, y = survival, color = x1_group, fill = x1_group)) +
  geom_smooth(method = "loess", se = TRUE, alpha = 0.2, linewidth = 1.2) +
  scale_color_manual(values = group_colors_x1, name = "Group") +
  scale_fill_manual(values = group_colors_x1, name = "Group") +
  scale_y_continuous(limits = c(0, 1), breaks = seq(0, 1, 0.2)) +
  theme_bw(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 12),
    panel.grid.minor = element_blank(),
    panel.border = element_rect(color = "gray70", linewidth = 0.5),
    legend.position = "right"
  ) +
  labs(
    title = "Survival",
    x = "Time",
    y = "Survival Probability"
  )

# Combine all panels for x1 groups
p_x1_combined <- (p_x1_survival | p_x1_biomarker) / (p_x1_velocity | p_x1_acceleration)

ggsave(
  filename = "trajectories-population-x1.png",
  plot = p_x1_combined,
  width = 14,
  height = 10,
  dpi = 300
)

cat("  ✓ Saved: trajectories-population-x1.png\n")

# ============================================================================
# Random Effects Distribution
# ============================================================================
cat("\n[Plot 5/5] Random effects distribution...\n")

# Extract random effects from the fitted model
if (!is.null(fit$random_effects)) {
  re <- fit$random_effects

  # Convert to data frame for plotting
  re_df <- as.data.frame(re)
  re_names <- colnames(re_df)
  n_effects <- length(re_names)

  cat(sprintf("  Number of random effects: %d (%s)\n", n_effects, paste(re_names, collapse = ", ")))

  # If there are exactly 2 random effects, create 2D distribution plot
  if (n_effects == 2) {
    # Create a detailed 2D scatter plot with density contours
    p_re_2d <- ggplot(re_df, aes(x = .data[[re_names[1]]], y = .data[[re_names[2]]])) +
      geom_point(alpha = 0.5, size = 2, color = "#3498db") +
      geom_density_2d(color = "#e74c3c", linewidth = 0.8) +
      geom_vline(xintercept = 0, linetype = "dashed", color = "gray50", linewidth = 0.5) +
      geom_hline(yintercept = 0, linetype = "dashed", color = "gray50", linewidth = 0.5) +
      theme_bw(base_size = 11) +
      theme(
        plot.title = element_text(face = "bold", size = 13),
        panel.grid.minor = element_blank(),
        panel.border = element_rect(color = "gray70", linewidth = 0.5)
      ) +
      labs(
        title = "2D Distribution of Random Effects",
        x = re_names[1],
        y = re_names[2]
      )

    ggsave(
      filename = "random-effects-distribution.png",
      plot = p_re_2d,
      width = 8,
      height = 7,
      dpi = 300
    )

    cat("  ✓ Saved: random-effects-distribution.png\n")
  } else if (n_effects > 2) {
    cat(sprintf("  Warning: %d random effects found; 2D plot requires exactly 2 effects\n", n_effects))
  } else if (n_effects == 1) {
    cat("  Warning: Only 1 random effect found; 2D plot requires exactly 2 effects\n")
  }

  # Print summary statistics
  cat("\n  Summary Statistics:\n")
  for (eff_name in re_names) {
    cat(sprintf("  %s: Mean = %.4f, SD = %.4f, Range = [%.4f, %.4f]\n",
                eff_name,
                mean(re_df[[eff_name]]),
                sd(re_df[[eff_name]]),
                min(re_df[[eff_name]]),
                max(re_df[[eff_name]])))
  }
} else {
  cat("  Warning: No random effects found in fitted model\n")
}

cat("\n========================================\n")
cat("All visualization plots completed\n")
cat("========================================\n")
