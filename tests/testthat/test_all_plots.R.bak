# Test script for all plot functions in JointODE package
# This script tests all possible plot types and variations

devtools::load_all("/Users/gongziyang/Desktop/JointODE")

cat("Fitting JointODE model...\n")
fit <- readRDS("/Users/gongziyang/Library/Mobile Documents/com~apple~CloudDocs/Downloads/jointode_n=200_m=100_seed=1.rds")

cat("\nModel fitted successfully!\n")
cat("========================================\n")
cat("Testing all plot functions...\n")
cat("========================================\n\n")

# Create output directory for plots
if (!dir.exists("test_plots")) {
  dir.create("test_plots")
}

# ============================================================================
# 1. OVERVIEW PLOT
# ============================================================================
cat("1. Testing overview plot...\n")
pdf("test_plots/01_overview.pdf", width = 10, height = 8)
plot(fit, type = "overview")
dev.off()
cat("   ✓ Saved to test_plots/01_overview.pdf\n\n")

# ============================================================================
# 2. BIOMARKER PLOTS
# ============================================================================
cat("2. Testing biomarker plots...\n")

# 2a. Overall biomarker trajectory
pdf("test_plots/02a_biomarker_overall.pdf", width = 10, height = 6)
plot(fit, type = "biomarker")
dev.off()
cat("   ✓ Saved to test_plots/02a_biomarker_overall.pdf\n")

# 2b. Biomarker by continuous covariate (w1)
pdf("test_plots/02b_biomarker_by_w1.pdf", width = 10, height = 6)
plot(fit, type = "biomarker", by = "w1")
dev.off()
cat("   ✓ Saved to test_plots/02b_biomarker_by_w1.pdf\n")

# 2c. Biomarker by continuous covariate (w2)
pdf("test_plots/02c_biomarker_by_w2.pdf", width = 10, height = 6)
plot(fit, type = "biomarker", by = "w2")
dev.off()
cat("   ✓ Saved to test_plots/02c_biomarker_by_w2.pdf\n")

# 2d. Biomarker by time-varying covariate mean (x1)
pdf("test_plots/02d_biomarker_by_x1.pdf", width = 10, height = 6)
plot(fit, type = "biomarker", by = "x1")
dev.off()
cat("   ✓ Saved to test_plots/02d_biomarker_by_x1.pdf\n")

# 2e. Biomarker by time-varying covariate mean (x2)
pdf("test_plots/02e_biomarker_by_x2.pdf", width = 10, height = 6)
plot(fit, type = "biomarker", by = "x2")
dev.off()
cat("   ✓ Saved to test_plots/02e_biomarker_by_x2.pdf\n")

# 2f. Biomarker with specific subject IDs (faceted view)
pdf("test_plots/02f_biomarker_subjects.pdf", width = 10, height = 6)
plot(fit, type = "biomarker", subject_ids = c("10", "25", "50", "75", "100", "150"))
dev.off()
cat("   ✓ Saved to test_plots/02f_biomarker_subjects.pdf\n\n")

