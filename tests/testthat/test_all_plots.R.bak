plot(fit, type = "velocity", show_individual = FALSE)
dev.off()
cat("   ✓ Saved to test_plots/08e_velocity_fitted_no_individual.pdf\n")

# 8f. Biomarker grouped by w1: show_individual = FALSE
pdf("test_plots/08f_biomarker_by_w1_no_individual.pdf", width = 10, height = 6)
plot(fit, type = "biomarker", by = "w1", show_individual = FALSE)
dev.off()
cat("   ✓ Saved to test_plots/08f_biomarker_by_w1_no_individual.pdf\n")

# 8g. Velocity grouped by w1: show_individual = FALSE
pdf("test_plots/08g_velocity_by_w1_no_individual.pdf", width = 10, height = 6)
plot(fit, type = "velocity", by = "w1", show_individual = FALSE)
dev.off()
