# ============================================================================
# 8. PARAMETER COMBINATION TESTS
# ============================================================================
cat("8. Testing parameter combinations (show_observed, show_individual)...\n")

# 8a. Biomarker: with observed data points (faceted view with specific subjects)
pdf("test_plots/08a_biomarker_with_observed.pdf", width = 10, height = 6)
plot(fit, type = "biomarker", subject_ids = c("10", "25", "50"), show_observed = TRUE)
dev.off()
cat("   ✓ Saved to test_plots/08a_biomarker_with_observed.pdf\n")

# 8b. Biomarker: faceted view without observed data points
pdf("test_plots/08b_biomarker_no_observed.pdf", width = 10, height = 6)
plot(fit, type = "biomarker", subject_ids = c("10", "25", "50"), show_observed = FALSE)
dev.off()
cat("   ✓ Saved to test_plots/08b_biomarker_no_observed.pdf\n")

# 8c. Biomarker: overlay view with mean only (no individual curves)
pdf("test_plots/08c_biomarker_mean_only.pdf", width = 10, height = 6)
plot(fit, type = "biomarker", show_individual = FALSE)
dev.off()
cat("   ✓ Saved to test_plots/08c_biomarker_mean_only.pdf\n")

