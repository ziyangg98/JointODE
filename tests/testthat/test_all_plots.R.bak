# 5. SURVIVAL PLOTS
# ============================================================================
cat("5. Testing survival plots...\n")

# 5a. Overall survival curve
pdf("test_plots/05a_survival_overall.pdf", width = 10, height = 6)
plot(fit, type = "survival")
